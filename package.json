{
  "name": "ppdm-alert-bot",
  "version": "1.3.2",
  "description": "Backup alerting for Dell EMC PPDM and NetWorker — webhook events and proactive SLA and storage checks, sent to Slack, Teams, PagerDuty and email, with an MCP server for Claude Code",
  "type": "module",
  "bin": {
    "ppdm-alert-bot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "keywords": [
    "ppdm",
    "networker",
    "dell-emc",
    "webhook",
    "slack",
    "teams",
    "backup",
    "alerts",
    "mcp",
    "claude-code",
    "pagerduty",
    "email",
    "sla"
  ],
  "author": "Moodswing9",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.0.0",
    "nodemailer": "^10.0.13",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Moodswing9/ppdm-alert-bot.git"
  },
  "homepage": "https://moodswing9.github.io",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Moodswing9/ppdm-alert-bot/issues"
  }
}
